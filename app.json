{
  "expo": {
    "name": "ReadMe",
    "slug": "readme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "readme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.readme.pdfreader"
    },
    "android": {
      "package": "com.readme.pdfreader",
      "adaptiveIcon": {
        "backgroundColor": "#16131B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16131B",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
